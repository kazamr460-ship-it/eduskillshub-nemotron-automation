# Copy to .env and fill in real values locally. Never commit real secrets.

# Nebius Token Factory API key (https://tokenfactory.nebius.com/)
NEBIUS_API_KEY=

# Base URL of the eduskillshub.site WordPress install (no trailing slash)
EDUSKILLSHUB_BASE_URL=https://eduskillshub.site

# Optional: shared secret if you add auth to the /wp-json/eduskills/v1/ingest route
EDUSKILLSHUB_INGEST_SHARED_SECRET=

# Optional: shared secret for the Make.com webhook's built-in API-key auth
MAKE_WEBHOOK_API_KEY=
